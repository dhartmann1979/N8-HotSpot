[Unit]
Description=DMRGateway (G4KLX) – connection to the DMR server
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=n8hotspot
Group=n8hotspot
WorkingDirectory=/opt/n8hotspot/data
ExecStart=/usr/local/bin/DMRGateway /opt/n8hotspot/data/DMRGateway.ini
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
